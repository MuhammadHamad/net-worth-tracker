# Optional cloud sync (Supabase). The app works fully offline without these —
# sign-in / sync only appears once both are set. Copy this file to `.env.local`
# and paste the values from your Supabase project (Project Settings → API).
#
# The anon key is the PUBLIC client key (safe to ship in a frontend). Never put
# the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
